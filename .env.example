# Local development defaults. Set a strong random SECRET_KEY and DEBUG=False in production.
SECRET_KEY=replace-with-a-random-secret-before-deploy
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite locally. For PostgreSQL set DATABASE_ENGINE=django.db.backends.postgresql and configure NAME/USER/PASSWORD/HOST/PORT.
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=sandbox/db.sqlite
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=

# Used by the local Docker Compose PostgreSQL service.
POSTGRES_DB=momand_store
POSTGRES_USER=momand
POSTGRES_PASSWORD=replace-this-local-development-password
REDIS_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

STORE_CURRENCY=AFN
STORE_TAX_RATE=0
STORE_ADDRESS=
STORE_PHONE=
STORE_EMAIL=
FRONTEND_URL=http://localhost:5173
